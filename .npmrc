# Isolated node_modules: a package can only import what it actually declares. This is pnpm's
# default and it is stated explicitly because the workspace depends on it — a phantom dependency
# that resolves in development and not in a Vercel build is an expensive way to find that out.
node-linker=isolated

# Expo (React 18) and Next (React 19) used to coexist here, and keeping their React versions and
# @types/react apart drove both a hoist-pattern block and a packageExtensions block (AD-01). The
# Expo app was retired on 2026-08-03 and every remaining app is React 19, so both are gone and
# hoisting is back to pnpm's default. Re-read AD-01 before reintroducing a second React.
strict-peer-dependencies=false
