# Expo SDK 52 targets React 18; Next 15 targets React 19. pnpm's isolated layout keeps the two
# runtimes apart — this is why the workspace uses pnpm and not npm workspaces (AD-01).
node-linker=isolated
strict-peer-dependencies=false

# pnpm hoists every package into node_modules/.pnpm/node_modules for compatibility. TypeScript
# walks up from a package's real path and finds React 19's types there, which then leak into the
# mobile app's type-check. Keep the React type packages out of that shared directory so each app
# resolves the @types/react its own React version needs.
hoist-pattern[]=*
hoist-pattern[]=!@types/react
hoist-pattern[]=!@types/react-dom
