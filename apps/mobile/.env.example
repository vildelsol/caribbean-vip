# Caribbean VIP — tourist app (Expo)
# Operating rule 10: never commit a real value. Copy to .env and fill in locally.
# Every EXPO_PUBLIC_ variable is shipped in the app bundle and MUST NOT be secret (PRD §14).

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_APP_ENV=local

# mock | google | mapbox — provider undecided (OD-05). `mock` needs no key and keeps the
# list view fully functional.
EXPO_PUBLIC_MAPS_PROVIDER=mock
EXPO_PUBLIC_MAPS_PUBLIC_KEY=
