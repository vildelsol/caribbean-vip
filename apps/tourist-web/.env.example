# Caribbean VIP — tourist app
# VITE_ variables are compiled into the browser bundle. Never put secrets here.
#
# Leave these blank to run in demo mode (no Supabase, no Stripe, simulated payment).
# Fill both to run in live mode (real Stripe checkout, real Supabase backend).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
