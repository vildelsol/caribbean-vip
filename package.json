{
  "name": "caribbean-vip",
  "version": "0.1.0",
  "private": true,
  "description": "Caribbean VIP — regional tourism marketplace. One platform. Every island.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "build": "pnpm -r --if-present run build",
    "vendor": "pnpm --filter @cvip/vendor-web dev",
    "admin": "pnpm --filter @cvip/admin-web dev",
    "db:test": "./scripts/db-test.sh",
    "db:concurrency": "./scripts/db-concurrency-test.sh",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm db:test",
    "db:push": "./scripts/db-push.sh",
    "demo": "./scripts/demo.sh",
    "tourist": "pnpm --filter @cvip/tourist-web dev",
    "tourist:build": "pnpm --filter @cvip/tourist-web build",
    "scanner:seed": "pnpm --filter @cvip/tourist-web exec node scripts/seed-scanner-test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23",
      "nanoid": ">=3.3.18",
      "source-map-js": ">=1.2.2",
      "sharp": ">=0.35.5"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mrhx-c7xc-m3w5"
      ]
    }
  }
}
